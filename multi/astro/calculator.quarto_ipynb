      "source": [
        "---\n",
        "title: \"Arbistrology - Your Cosmic Guide\"\n",
        "format: html\n",
        "jupyter: python3\n",
        "execute:\n",
        "  warning: false\n",
        "  message: false\n",
        "  echo: false\n",
        "  enabled: true\n",
