    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# This is a Python code cell in your Quarto document\n",
        "from IPython.display import display, HTML\n",
        "\n",
        "# Create HTML with embedded JavaScript for interactivity\n",
        "html_content = \"\"\"\n",
        "<div id=\"datetime-selector\">\n",
        "    <div class=\"container-layout\">\n",
        "        <div class=\"form-container\">\n",
        "            <div class=\"date-row\">\n",
        "                <div class=\"form-group\">\n",
        "                    <label for=\"day\">Day:</label>\n",
        "                    <select id=\"day\" class=\"form-control\">\n",
        "                        \"\"\" + ''.join([f'<option value=\"{i}\">{i}</option>' for i in range(1, 32)]) + \"\"\"\n",
        "                    </select>\n",
        "                </div>\n",
        "                \n",
        "                <div class=\"form-group\">\n",
        "                    <label for=\"month\">Month:</label>\n",
        "                    <select id=\"month\" class=\"form-control\">\n",
        "                        \"\"\" + ''.join([f'<option value=\"{i}\">{i}</option>' for i in range(1, 13)]) + \"\"\"\n",
        "                    </select>\n",
        "                </div>\n",
        "                \n",
        "                <div class=\"form-group\">\n",
        "                    <label for=\"year\">Year:</label>\n",
        "                    <select id=\"year\" class=\"form-control\">\n",
        "                        \"\"\" + ''.join([f'<option value=\"{i}\">{i}</option>' for i in range(2020, 2030)]) + \"\"\"\n",
        "                    </select>\n",
        "                </div>\n",
        "            </div>\n",
        "            \n",
        "            <div class=\"time-row\">\n",
        "                <div class=\"form-group\">\n",
        "                    <label for=\"hour\">Hour:</label>\n",
        "                    <select id=\"hour\" class=\"form-control\">\n",
        "                        \"\"\" + ''.join([f'<option value=\"{i:02d}\">{i:02d}</option>' for i in range(0, 24)]) + \"\"\"\n",
        "                    </select>\n",
        "                </div>\n",
        "                \n",
        "                <div class=\"form-group\">\n",
        "                    <label for=\"minute\">Minute:</label>\n",
        "                    <select id=\"minute\" class=\"form-control\">\n",
        "                        \"\"\" + ''.join([f'<option value=\"{i:02d}\">{i:02d}</option>' for i in range(0, 60)]) + \"\"\"\n",
        "                    </select>\n",
        "                </div>\n",
        "            </div>\n",
        "            \n",
        "            <button id=\"generate-btn\" class=\"btn btn-primary mt-3\">Generate Assignment</button>\n",
        "        </div>\n",
        "        \n",
        "        <div class=\"confirmation-container\">\n",
        "            <div id=\"output-message\" class=\"mt-3\"></div>\n",
        "            <div id=\"confirmation-buttons\" class=\"mt-3\" style=\"display: none;\">\n",
        "                <button id=\"confirm-btn\" class=\"btn btn-success\">Confirm</button>\n",
        "                <button id=\"cancel-btn\" class=\"btn btn-danger\">Cancel</button>\n",
        "            </div>\n",
        "        </div>\n",
        "    </div>\n",
        "    \n",
        "    <!-- Results section -->\n",
        "    <div id=\"results-container\" class=\"mt-3\" style=\"display: none;\">\n",
        "        <h2>Your Cosmic Assignment Results</h2>\n",
        "        <div id=\"planet-assignment\" class=\"planet-result\"></div>\n",
        "        <div id=\"placement-results\" class=\"placement-results\"></div>\n",
        "    </div>\n",
        "</div>\n",
        "\n",
        "<style>\n",
        "#datetime-selector {\n",
        "    width: 100%;\n",
        "    margin: 20px 0;\n",
        "}\n",
        "\n",
        "/* Container layout for side-by-side display */\n",
        ".container-layout {\n",
        "    display: flex;\n",
        "    flex-direction: row;\n",
        "    align-items: flex-start;\n",
        "}\n",
        "\n",
        ".form-container {\n",
        "    flex: 0 0 auto;\n",
        "    margin-right: 30px;\n",
        "}\n",
        "\n",
        ".confirmation-container {\n",
        "    flex: 0 0 300px;\n",
        "    padding: 15px;\n",
        "    border-left: 1px solid #ddd;\n",
        "    min-height: 150px;\n",
        "}\n",
        "\n",
        "/* Style for date and time rows */\n",
        ".date-row, .time-row {\n",
        "    display: flex;\n",
        "    margin-bottom: 15px;\n",
        "}\n",
        "\n",
        "/* Make the form groups display inline */\n",
        ".form-group {\n",
        "    margin-right: 15px;\n",
        "}\n",
        "\n",
        ".form-control {\n",
        "    display: block;\n",
        "    width: 200px;\n",
        "    padding: 8px;\n",
        "    font-size: 14px;\n",
        "    height: 38px;\n",
        "    border: 1px solid #ced4da;\n",
        "    border-radius: 4px;\n",
        "}\n",
        "\n",
        ".btn {\n",
        "    padding: 8px 16px;\n",
        "    cursor: pointer;\n",
        "    border: none;\n",
        "    border-radius: 4px;\n",
        "    font-size: 16px;\n",
        "    margin-right: 10px;\n",
        "}\n",
        "\n",
        ".btn-primary { background-color: #007bff; color: white; }\n",
        ".btn-success { background-color: #28a745; color: white; }\n",
        ".btn-danger { background-color: #dc3545; color: white; }\n",
        ".mt-3 { margin-top: 15px; }\n",
        "\n",
        "#user-name {\n",
        "    width: 100%;\n",
        "    margin-top: 5px;\n",
        "    margin-bottom: 10px;\n",
        "    padding: 8px;\n",
        "    border: 1px solid #ced4da;\n",
        "    border-radius: 4px;\n",
        "}\n",
        "\n",
        "/* Error styling */\n",
        ".error-text {\n",
        "    color: #dc3545;\n",
        "    font-size: 14px;\n",
        "    margin-top: 5px;\n",
        "}\n",
        "\n",
        "/* Results styling */\n",
        "#results-container {\n",
        "    margin-top: 30px;\n",
        "    padding: 20px;\n",
        "    border: 1px solid #ddd;\n",
        "    border-radius: 8px;\n",
        "    background-color: #f8f9fa;\n",
        "}\n",
        "\n",
        ".planet-result {\n",
        "    margin-bottom: 20px;\n",
        "    padding: 15px;\n",
        "    background-color: #e9ecef;\n",
        "    border-radius: 5px;\n",
        "    font-size: 18px;\n",
        "}\n",
        "\n",
        ".placement-results {\n",
        "    margin-top: 10px;\n",
        "}\n",
        "\n",
        ".placement-item {\n",
        "    margin-bottom: 10px;\n",
        "    padding: 10px;\n",
        "    background-color: #e2e3e5;\n",
        "    border-left: 4px solid #6c757d;\n",
        "    border-radius: 3px;\n",
        "}\n",
        "\n",
        ".planet-name {\n",
        "    font-weight: bold;\n",
        "    color: #0056b3;\n",
        "    font-size: 22px;\n",
        "}\n",
        "\n",
        ".reason-number {\n",
        "    font-weight: bold;\n",
        "    margin-right: 5px;\n",
        "    color: #495057;\n",
        "}\n",
        "</style>\n",
        "\n",
        "<script>\n",
        "document.addEventListener('DOMContentLoaded', function() {\n",
        "    // Get references to all elements\n",
        "    const daySelect = document.getElementById('day');\n",
        "    const monthSelect = document.getElementById('month');\n",
        "    const yearSelect = document.getElementById('year');\n",
        "    const hourSelect = document.getElementById('hour');\n",
        "    const minuteSelect = document.getElementById('minute');\n",
        "    const generateBtn = document.getElementById('generate-btn');\n",
        "    const outputMessage = document.getElementById('output-message');\n",
        "    const confirmationButtons = document.getElementById('confirmation-buttons');\n",
        "    const confirmBtn = document.getElementById('confirm-btn');\n",
        "    const cancelBtn = document.getElementById('cancel-btn');\n",
        "    const resultsContainer = document.getElementById('results-container');\n",
        "    const planetAssignment = document.getElementById('planet-assignment');\n",
        "    const placementResults = document.getElementById('placement-results');\n",
        "    \n",
        "    // Store selected values\n",
        "    let selectedValues = {};\n",
        "    let currentStep = 'datetime'; // Possible values: 'datetime', 'name', 'complete'\n",
        "    \n",
        "    // Planets for random assignment\n",
        "    const planets = [\n",
        "        \"Mercury\", \"Venus\", \"Mars\", \"Jupiter\", \"Saturn\", \n",
        "        \"Uranus\", \"Neptune\", \"Pluto\", \"Ceres\", \"Eris\"\n",
        "    ];\n",
        "    \n",
        "    // Placements/reasons for assignment\n",
        "    const placements = [\n",
        "        \"Your cosmic energy aligns perfectly with this planet's vibrations\",\n",
        "        \"The planetary position at your birth time creates a strong affinity\",\n",
        "        \"Your numerological profile resonates with this celestial body\",\n",
        "        \"Quantum astrological calculations indicate this is your cosmic home\",\n",
        "        \"The celestial harmonics of your birth chart point directly here\",\n",
        "        \"Interstellar alignments suggest a powerful connection between you\",\n",
        "        \"Your chronological signature matches this planet's frequency\",\n",
        "        \"Astral projections from your birth time converge at this location\",\n",
        "        \"The metaphysical properties of your name link to this planet\",\n",
        "        \"Cosmic wavelength analysis shows strong compatibility\",\n",
        "        \"Gravitational pull calculations favor this assignment\",\n",
        "        \"Your biorhythmic pattern mirrors this planet's orbit\",\n",
        "        \"Stellar cartography indicates this as your spiritual center\",\n",
        "        \"Astronomical algorithms highlight this cosmic connection\",\n",
        "        \"Astrobiological factors show natural affinity to this environment\"\n",
        "    ];\n",
        "    \n",
        "    // Function to generate random results\n",
        "    function generateRandomResults(name) {\n",
        "        // Randomly select a planet\n",
        "        const randomPlanet = planets[Math.floor(Math.random() * planets.length)];\n",
        "        \n",
        "        // Randomly select 5 unique placements\n",
        "        let selectedPlacements = [];\n",
        "        let remainingPlacements = [...placements]; // Create a copy to work with\n",
        "        \n",
        "        for (let i = 0; i < 5 && remainingPlacements.length > 0; i++) {\n",
        "            const randomIndex = Math.floor(Math.random() * remainingPlacements.length);\n",
        "            selectedPlacements.push(remainingPlacements[randomIndex]);\n",
        "            remainingPlacements.splice(randomIndex, 1); // Remove selected placement\n",
        "        }\n",
        "        \n",
        "        // Create the results HTML\n",
        "        planetAssignment.innerHTML = `<p>Based on your cosmic profile, ${name}, you have been assigned to: <span class=\"planet-name\">${randomPlanet}</span></p>`;\n",
        "        \n",
        "        let placementsHTML = '<h3>Top 5 Reasons for This Assignment:</h3>';\n",
        "        selectedPlacements.forEach((placement, index) => {\n",
        "            placementsHTML += `<div class=\"placement-item\">\n",
        "                <span class=\"reason-number\">${index + 1}.</span> ${placement}\n",
        "            </div>`;\n",
        "        });\n",
        "        \n",
        "        placementResults.innerHTML = placementsHTML;\n",
        "        resultsContainer.style.display = 'block';\n",
        "    }\n",
        "    \n",
        "    // Add click event for the generate button\n",
        "    generateBtn.addEventListener('click', function() {\n",
        "        // Store all selected values\n",
        "        selectedValues = {\n",
        "            day: daySelect.value,\n",
        "            month: monthSelect.value,\n",
        "            year: yearSelect.value,\n",
        "            hour: hourSelect.value,\n",
        "            minute: minuteSelect.value\n",
        "        };\n",
        "        \n",
        "        // Display confirmation message\n",
        "        outputMessage.innerHTML = `<h4>Confirm Your Selection</h4>\n",
        "                                  <p>Date: ${selectedValues.day}/${selectedValues.month}/${selectedValues.year}<br>\n",
        "                                  Time: ${selectedValues.hour}:${selectedValues.minute}</p>\n",
        "                                  <p>Are you sure you want to proceed?</p>`;\n",
        "        \n",
        "        // Show confirmation buttons\n",
        "        confirmationButtons.style.display = 'block';\n",
        "    });\n",
        "    \n",
        "    // Add click event for confirm button\n",
        "    confirmBtn.addEventListener('click', function() {\n",
        "        outputMessage.innerHTML = `<h4>Confirmation Successful</h4>\n",
        "                                  <p>Date: ${selectedValues.day}/${selectedValues.month}/${selectedValues.year}<br>\n",
        "                                  Time: ${selectedValues.hour}:${selectedValues.minute}</p>\n",
        "                                  <p>Please enter your name:</p>\n",
        "                                  <div class=\"form-group\">\n",
        "                                    <input type=\"text\" id=\"user-name\" class=\"form-control\" placeholder=\"Enter your name\">\n",
        "                                  </div>\n",
        "                                  <button id=\"submit-name-btn\" class=\"btn btn-primary mt-3\">Submit</button>`;\n",
        "        confirmationButtons.style.display = 'none';\n",
        "        \n",
        "        // Add event listener for the new submit button\n",
        "        setTimeout(() => {\n",
        "            const submitNameBtn = document.getElementById('submit-name-btn');\n",
        "            const userNameInput = document.getElementById('user-name');\n",
        "            \n",
        "            submitNameBtn.addEventListener('click', function() {\n",
        "                const userName = userNameInput.value.trim();\n",
        "                if (userName) {\n",
        "                    // Store the name along with the date/time\n",
        "                    selectedValues.name = userName;\n",
        "                    \n",
        "                    // Show final confirmation\n",
        "                    outputMessage.innerHTML = `<h4>All Information Received</h4>\n",
        "                                            <p>Name: ${selectedValues.name}</p>\n",
        "                                            <p>Date: ${selectedValues.day}/${selectedValues.month}/${selectedValues.year}<br>\n",
        "                                            Time: ${selectedValues.hour}:${selectedValues.minute}</p>\n",
        "                                            <p>Your cosmic assignment is ready below!</p>`;\n",
        "                                            \n",
        "                    // Generate and display random results\n",
        "                    generateRandomResults(userName);\n",
        "                    \n",
        "                } else {\n",
        "                    // Show error if name is empty\n",
        "                    userNameInput.style.borderColor = 'red';\n",
        "                    const errorMsg = document.createElement('p');\n",
        "                    errorMsg.className = 'error-text';\n",
        "                    errorMsg.textContent = 'Please enter your name';\n",
        "                    \n",
        "                    // Insert error message after input if it doesn't exist\n",
        "                    if (!userNameInput.nextElementSibling || !userNameInput.nextElementSibling.className !== 'error-text') {\n",
        "                        userNameInput.parentNode.insertBefore(errorMsg, userNameInput.nextElementSibling);\n",
        "                    }\n",
        "                }\n",
        "            });\n",
        "        }, 100); // Small timeout to ensure the element is in the DOM\n",
        "    });\n",
        "    \n",
        "    // Add click event for cancel button\n",
        "    cancelBtn.addEventListener('click', function() {\n",
        "        outputMessage.innerHTML = '<h4>Cancelled</h4><p>Please adjust your selection if needed.</p>';\n",
        "        confirmationButtons.style.display = 'none';\n",
        "    });\n",
        "});\n",
        "</script>\n",
        "\"\"\"\n",
        "\n",
        "# Display the HTML\n",
        "display(HTML(html_content))"
      ],
      "id": "8b1e958e",
      "execution_count": null,
      "outputs": []
    }
