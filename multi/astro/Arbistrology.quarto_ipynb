        "</style>\n",
        "\n",
        "<script>\n",
        "document.addEventListener('DOMContentLoaded', function() {\n",
        "    // Get references to all elements\n",
        "    const daySelect = document.getElementById('day');\n",
        "    const monthSelect = document.getElementById('month');\n",
        "    const yearSelect = document.getElementById('year');\n",
        "    const hourSelect = document.getElementById('hour');\n",
        "    const minuteSelect = document.getElementById('minute');\n",
        "    const generateBtn = document.getElementById('generate-btn');\n",
        "    const outputMessage = document.getElementById('output-message');\n",
        "    const confirmationButtons = document.getElementById('confirmation-buttons');\n",
        "    const confirmBtn = document.getElementById('confirm-btn');\n",
        "    const cancelBtn = document.getElementById('cancel-btn');\n",
        "    const assignmentResults = document.getElementById('assignment-results');\n",
        "    const resultContent = document.getElementById('result-content');\n",
        "    \n",
        "    // Store selected values\n",
        "    let selectedValues = {};\n",
        "    let currentStep = 'datetime'; // Possible values: 'datetime', 'name', 'complete'\n",
        "    \n",
        "    // Lists for random assignments\n",
        "    const planets = [\n",
        "        \"Mercury\", \"Venus\", \"Mars\", \"The Densely Populated Federation (formerly Jupiter; colonized by China and India)\", \"Saturn\", \n",
        "        \"Ur-Anus (formerly Uranus)\", \"Neptune\", \"The Prison Federation (formerly Pluto; colonized by Australia and ???)\", \"Ceres\", \"Eris\", \n",
        "        \"Station-452b\", \"Starlink-1e\", \"Elon 189733b\", \"Bezos Centauri b\", \"Aristole 581g\"\n",
        "    ];\n",
        "    \n",
        "    const jobs = [\n",
        "        \"Endentured Servant\", \"Stellar Jester\", \"Concubine\", \n",
        "        \"Alchemist\", \"Police Officer\", \"Professor\", \"Space Diplomat\", \n",
        "        \"Personal Chef\", \"Galactic Historian\", \"Interstellar Artist\",\n",
        "        \"Planetary Engineer\", \"Star Whisperer\", \"Comet Rider\", \"Wormhole Technician\", \n",
        "        \"Temporal Guardian\"\n",
        "    ];\n",
        "    \n",
        "    const plantationTypes = [\n",
        "        \"Knowles-Carter Crystal Orchards\", \"Antigone-Gravity Moss Fields\", \n",
        "        \"Mexican Bamboo Forests\", \"SLothful Flower Gardens\", \n",
        "        \"Trump Energy Farms\", \"Lafayette Mushroom Caverns\", \n",
        "        \"Pomona Fruit Vineyards\", \"Scripps Matter Herb Terraces\", \n",
        "        \"Harvey Mudd Ray Vegetable Plots\", \"CMC Belt Lichen Colonies\",\n",
        "        \"CGU Tulip Meadows\", \"KGI-Point Energy Root Farms\",\n",
        "        \"Magnetic Rose Gardens\", \"Misc. Spice Plantation\",\n",
        "        \"Neutron Star Succulents\"\n",
        "    ];\n",
        "    \n",
        "    const reasons = [\n",
        "        \"Neptune in the 10th House: Disillusionment with your career. Let us get youback on track with some servitude!\",\n",
        "        \"Saturn in the 8th House: The alignment of Saturn at your birth indicates natural talent in this field\",\n",
        "        \"Your numerological pattern suggests exceptional adaptability to harsh, arid environments. You'd love it here!\",\n",
        "        \"Sun in the 4th House: The stellar wind patterns say you may dislike your mother. Leave her behind and go to space!\",\n",
        "        \"Ancient celestial texts predicted your destiny for this role\",\n",
        "        \"Your aura's wavelength matches the harmonic frequency of this position\",\n",
        "        \"The quantum entanglement of your birth stars predisposed you to excel here\",\n",
        "        \"Your Sun's element (Earth) has natural synergy with this placement\",\n",
        "        \"Uranus conjuct Elon-89389: The energy active during your birth created an affinity for innovative work\",\n",
        "        \"Interdimensional calculations show this is your optimal planet if you want clear skin (likely highly valued due to Moon in the 6th house)\",\n",
        "        \"Sir Baron Musk-Trump III of Mars recently decreed that those with Jupitarian influence should go here to bring abundance to the rest of the servants.\",\n",
        "        \"War has erupted between the Indo-Carribean and Indo-American colonies; you are destined to be a fighter (Mars in the 1stHouse)! Armor up!\",\n",
        "        \"Your soul's journey across previous incarnations has prepared you for this task\",\n",
        "        \"The galactic core's radiation pattern at your birth time encoded this destiny\",\n",
        "        \"The orbital resonance of Neptune during your conception aligned with this purpose\",\n",
        "        \"Your spiritual DNA contains markers specifically attuned to this position\",\n",
        "        \"The asteroid belt configuration during your first breath predicted this path\",\n",
        "        \"Your quantum consciousness signature matches this assignment perfectly\",\n",
        "        \"The cosmic ray shower occurring on your birth date empowered this potential\",\n",
        "        \"Your metaphysical blueprint contains the exact structure needed for this role\"\n",
        "    ];\n",
        "    \n",
        "    // Planet histories and meanings\n",
        "    const planetHistories = {\n",
        "        \"Mercury\": \"Discovered by ancient civilizations as the Messenger Planet, Mercury was first colonized in 2189 during the Great Solar Expansion. Its proximity to the sun made it an ideal energy harvesting hub, and its rich deposits of rare metals transformed it into a center for quantum computing.\",\n",
        "        \"Venus\": \"Venus, once a toxic hellscape, was transformed through atmospheric engineering in 2214. The Cloud Cities of Venus now float above its surface, creating a paradise of airborne gardens and research centers dedicated to atmospheric sciences.\",\n",
        "        \"Mars\": \"The first human outpost on Mars was established in 2037, growing into a network of underground cities and terraformed valleys. Mars is now home to the Solar System's oldest off-Earth human settlements and boasts the most advanced agricultural research facilities.\",\n",
        "        \"Jupiter\": \"Jupiter's colonization began with floating cities in its upper atmosphere in 2185. The gas giant's powerful storms are now harnessed for energy production, while its dozens of moons serve as mining outposts and research stations.\",\n",
        "        \"Saturn\": \"The Rings of Saturn host the most beautiful human settlements in the solar system. Ring miners and artists coexist in harmony, creating floating cities that dance between the rings and harvest rare ice crystals for both practical and aesthetic purposes.\",\n",
        "        \"Uranus\": \"The sideways planet became humanity's gateway to deep space in 2289. Its unique axial tilt creates extreme seasonal variations that have spawned distinctive cultural adaptations among its colonists, who are known for their resilience and ingenuity.\",\n",
        "        \"Neptune\": \"The blue giant's colonization was focused on its largest moon, Triton. Neptune's powerful winds made it unsuitable for direct habitation until the development of pressure-resistant habitats in 2342, which now float like jewels in its beautiful azure storms.\",\n",
        "        \"Pluto\": \"Though small and distant, Pluto became a thriving outpost thanks to its abundant ice resources. The underground cities of Pluto are known for their tight-knit communities and advanced cryogenic research facilities.\",\n",
        "        \"Ceres\": \"The largest asteroid in the belt became the hub of the inner system's mining operations. Its central location made it an ideal trading post, eventually growing into one of the wealthiest commercial centers in the solar system.\",\n",
        "        \"Eris\": \"The distant dwarf planet was the last major solar system body to be colonized in 2401. Its extreme isolation attracted spiritual communities seeking separation from the hustle of inner system life.\",\n",
        "        \"Kepler-452b\": \"The first Earth-like exoplanet colonized by humans in 2567, Kepler-452b is known as 'Earth's Cousin.' Its similar gravity and atmosphere made it ideal for human adaptation, requiring minimal terraforming.\",\n",
        "        \"TRAPPIST-1e\": \"Part of the famous TRAPPIST system, this planet is known for its beautiful red sunsets and unique flora that evolved under the light of a red dwarf star. Human settlements are concentrated on its tidally-locked twilight zone.\",\n",
        "        \"HD 189733b\": \"This cobalt-blue gas giant was initially deemed uninhabitable until the development of advanced floating cities. It's now famous for its glass-making industry, utilizing the silicate rain in its upper atmosphere.\",\n",
        "        \"Proxima Centauri b\": \"Our closest exoplanet neighbor and the first stepping stone to the stars. Its tidally-locked nature created a unique band of habitability that circles the planet, known as the 'Green Ring.'\",\n",
        "        \"Gliese 581g\": \"Located in the habitable zone of its star, Gliese 581g became a center for exobiology research due to its native microbial life. Its colonists are known for their respect for indigenous lifeforms and careful approach to settlement.\"\n",
        "    };\n",
        "    \n",
        "    const jobMeanings = {\n",
        "        \"Cosmic Gardener\": \"These specialized botanists cultivate alien flora and create sustainable ecosystems in harsh planetary environments. Their work ensures food security and maintains the delicate balance of terraformed worlds.\",\n",
        "        \"Stellar Architect\": \"Masters of extreme engineering, Stellar Architects design habitats that can withstand the harshest cosmic conditions. Their work combines advanced materials science with artistic vision to create beautiful yet functional living spaces.\",\n",
        "        \"Nebula Navigator\": \"These skilled pilots chart courses through the most challenging regions of space. Their intuitive understanding of cosmic phenomena and expert handling of spacecraft makes them essential for interstellar travel.\",\n",
        "        \"Quantum Alchemist\": \"Part scientist, part artist, Quantum Alchemists manipulate matter at the subatomic level to create new materials with extraordinary properties. Their creations are vital for advanced technology and infrastructure.\",\n",
        "        \"Void Walker\": \"These specialized explorers venture into uncharted space, comfortable in the vast emptiness between stars. Their psychological fortitude and survival skills make them ideal for first-contact missions and discovering new resources.\",\n",
        "        \"Asteroid Miner\": \"The backbone of the space economy, Asteroid Miners extract precious metals and rare elements from celestial bodies. Their work fuels technological advancement and economic growth throughout colonized space.\",\n",
        "        \"Space Diplomat\": \"These skilled negotiators maintain peaceful relations between diverse planetary cultures. Their deep understanding of extraterrestrial customs and excellent communication skills prevent conflicts and foster cooperation.\",\n",
        "        \"Celestial Chef\": \"Masters of xenogastronomy, these culinary experts create delicious and nutritious meals from exotic ingredients found throughout the cosmos. Their work is crucial for morale and cultural exchange.\",\n",
        "        \"Galactic Historian\": \"These scholars document the expansion of human civilization beyond Earth and preserve the knowledge of ancient stellar civilizations. Their work ensures that lessons from the past guide future development.\",\n",
        "        \"Interstellar Artist\": \"These creative souls capture the beauty and wonder of cosmic environments through various mediums. Their work helps connect colonists with their new homes and expresses the human experience in space.\",\n",
        "        \"Planetary Engineer\": \"Specialists in large-scale environmental modification, these engineers transform hostile worlds into habitable ones. Their work combines geology, climatology, and ecology to create sustainable new homes for humanity.\",\n",
        "        \"Star Whisperer\": \"These unique individuals possess an intuitive connection with stellar phenomena. Their ability to predict solar storms and stellar behavior is crucial for the safety of nearby colonies and space traffic.\",\n",
        "        \"Comet Rider\": \"Part daredevil, part scientist, Comet Riders attach themselves to comets to study their composition and behavior. Their research provides valuable data about the early solar system and potential resources.\",\n",
        "        \"Wormhole Technician\": \"These cutting-edge scientists maintain the network of artificial wormholes that enable rapid interstellar travel. Their precise calculations and adjustments keep the fragile spacetime tunnels stable and safe.\",\n",
        "        \"Temporal Guardian\": \"Specialists who monitor and protect the stability of the spacetime continuum near high-gravity environments. Their work prevents dangerous temporal anomalies and ensures the consistent flow of time in colonized space.\"\n",
        "    };\n",
        "    \n",
        "    const plantationMeanings = {\n",
        "        \"Luminous Crystal Orchards\": \"These beautiful gardens grow crystalline structures that naturally emit light. The 'fruit' they produce is used for sustainable lighting across human settlements, combining aesthetic beauty with practical function.\",\n",
        "        \"Anti-Gravity Moss Fields\": \"This specialized moss naturally counteracts gravitational forces, creating floating patches of greenery. Harvested moss is used in medical treatments for bone density issues and in the construction of lightweight structures.\",\n",
        "        \"Quantum Bamboo Forests\": \"This rapidly-growing plant exists in multiple states simultaneously, making it ideal for computational biotechnology. Products derived from quantum bamboo form the basis of organic computing systems.\",\n",
        "        \"Nebula Flower Gardens\": \"These delicate blooms absorb trace gases from their environment, creating miniature nebula-like patterns in their petals. They're valued for their air-purification properties and stunning beauty.\",\n",
        "        \"Stellar Energy Farms\": \"These specialized plants convert stellar radiation directly into usable energy with efficiency exceeding any artificial solar panels. Their harvest provides clean power for entire settlements.\",\n",
        "        \"Void Mushroom Caverns\": \"These fungi thrive in complete darkness and naturally absorb radiation. They're crucial for waste management in space habitats and produce nutrients otherwise difficult to synthesize in space.\",\n",
        "        \"Plasma Fruit Vineyards\": \"These unusual plants produce fruit containing naturally occurring plasma that can be harvested for various technological applications. They require careful tending due to their inherently energetic nature.\",\n",
        "        \"Dark Matter Herb Terraces\": \"These mysterious plants interact with dark matter in ways science still doesn't fully understand. Their cultivation provides insights into this elusive cosmic component and yields herbs with unique medicinal properties.\",\n",
        "        \"Cosmic Ray Vegetable Plots\": \"These hardy vegetables are specifically bred to thrive under intense cosmic radiation. They not only survive but convert harmful rays into nutrients, making them ideal for outer solar system locations.\",\n",
        "        \"Asteroid Belt Lichen Colonies\": \"These resilient organisms grow on the surface of asteroids, slowly breaking down their mineral components into soil. They're essential for the first stages of asteroid terraforming and mining operations.\",\n",
        "        \"Dimensional Tulip Meadows\": \"These flowers occasionally phase between dimensional states, creating spectacular visual displays. Their pollen has applications in quantum physics research and interdimensional communication experiments.\",\n",
        "        \"Zero-Point Energy Root Farms\": \"These deep-growing root systems tap into zero-point energy fields. The harvested roots can store this energy indefinitely, serving as organic batteries for space habitats and vehicles.\",\n",
        "        \"Magnetic Rose Gardens\": \"These metallic-petaled roses naturally generate magnetic fields. They're used in navigation systems and in medical treatments for circulatory conditions, as well as being prized for their unique beauty.\",\n",
        "        \"Interstellar Spice Plantations\": \"These highly aromatic plants produce spices that not only enhance food but have preservative and medicinal properties. They've become valuable trade goods between different stellar systems.\",\n",
        "        \"Neutron Star Succulents\": \"These dense, water-rich plants can withstand extreme gravitational forces. Their extract is used in gravity adaptation treatments for humans transitioning between different planetary environments.\"\n",
        "    };\n",
        "    \n",
        "    // Overseer names and characteristics\n",
        "    const overseerFirstNames = [\n",
        "        \"Zephyr\", \"Nova\", \"Orion\", \"Lyra\", \"Castor\", \"Vega\", \"Atlas\", \"Celeste\", \n",
        "        \"Sirius\", \"Andromeda\", \"Phoenix\", \"Rigel\", \"Carina\", \"Altair\", \"Luna\"\n",
        "    ];\n",
        "    \n",
        "    const overseerLastNames = [\n",
        "        \"Stellaris\", \"Voidborn\", \"Cosmic\", \"Graviton\", \"Astralian\", \"Nebulon\", \n",
        "        \"Solstice\", \"Quasar\", \"Infiniti\", \"Galaxian\", \"Starweaver\", \"Pulsar\", \n",
        "        \"Eclipse\", \"Celestian\", \"Aetherwalk\"\n",
        "    ];\n",
        "    \n",
        "    const overseerTitles = [\n",
        "        \"Chief Cultivation Officer\", \"Planetary Stewardship Director\", \n",
        "        \"Senior Xenobotanist\", \"Master of Cosmic Agriculture\", \n",
        "        \"Head of Extraterrestrial Flora\", \"Interstellar Growth Coordinator\", \n",
        "        \"Principal Planetary Cultivator\", \"Supreme Harvest Guardian\", \n",
        "        \"Director of Cosmic Resources\", \"Executive Botanical Strategist\"\n",
        "    ];\n",
        "    \n",
        "    const overseerBackgrounds = [\n",
        "        \"has pioneered revolutionary growing techniques for low-gravity environments\",\n",
        "        \"was the first to successfully cultivate Earth plants on their assigned planet\",\n",
        "        \"comes from a long line of space agriculturalists dating back to the lunar colonies\",\n",
        "        \"left a prestigious academic position to pursue practical applications in space farming\",\n",
        "        \"discovered a new species of plant that now bears their name\",\n",
        "        \"holds multiple patents for terraforming technology\",\n",
        "        \"wrote the definitive text on extraterrestrial agriculture used in all major academies\",\n",
        "        \"survived alone for three years on an isolated outpost by growing their own food\",\n",
        "        \"has visited more planets than any other agricultural specialist in the system\",\n",
        "        \"developed a revolutionary irrigation system now used throughout colonized space\"\n",
        "    ];\n",
        "    \n",
        "    const overseerImages = [\n",
        "        \"/api/placeholder/400/400?text=Overseer+Profile+1\",\n",
        "        \"/api/placeholder/400/400?text=Overseer+Profile+2\",\n",
        "        \"/api/placeholder/400/400?text=Overseer+Profile+3\",\n",
        "        \"/api/placeholder/400/400?text=Overseer+Profile+4\",\n",
        "        \"/api/placeholder/400/400?text=Overseer+Profile+5\",\n",
        "        \"/api/placeholder/400/400?text=Overseer+Profile+6\",\n",
        "        \"/api/placeholder/400/400?text=Overseer+Profile+7\",\n",
        "        \"/api/placeholder/400/400?text=Overseer+Profile+8\",\n",
        "        \"/api/placeholder/400/400?text=Overseer+Profile+9\",\n",
        "        \"/api/placeholder/400/400?text=Overseer+Profile+10\"\n",
        "    ];\n",
        "    \n",
        "    // Ticket class tiers and prices\n",
        "    const ticketClasses = [\n",
        "        {\n",
        "            name: \"Stardust\",\n",
        "            description: \"Basic transportation with shared sleeping quarters\",\n",
        "            price: () => Math.floor(Math.random() * 500) + 1000,\n",
        "            amenities: [\"Shared sleeping pod\", \"Basic meals\", \"2kg personal luggage allowance\", \"Emergency medical care\"]\n",
        "        },\n",
        "        {\n",
        "            name: \"Nova\",\n",
        "            description: \"Improved comfort with semi-private accommodations\",\n",
        "            price: () => Math.floor(Math.random() * 1000) + 2500,\n",
        "            amenities: [\"Semi-private sleeping quarters\", \"Standard meals with options\", \"5kg personal luggage allowance\", \"Basic entertainment package\", \"Standard medical care\"]\n",
        "        },\n",
        "        {\n",
        "            name: \"Pulsar\",\n",
        "            description: \"Business-class travel with private quarters\",\n",
        "            price: () => Math.floor(Math.random() * 2000) + 5000,\n",
        "            amenities: [\"Private cabin\", \"Premium meals and beverages\", \"15kg personal luggage allowance\", \"Advanced entertainment system\", \"Priority boarding\", \"Comprehensive medical coverage\"]\n",
        "        },\n",
        "        {\n",
        "            name: \"Supernova Elite\",\n",
        "            description: \"Luxury travel experience with full amenities\",\n",
        "            price: () => Math.floor(Math.random() * 5000) + 12000,\n",
        "            amenities: [\"Luxury suite with viewport\", \"Gourmet dining experience\", \"50kg personal luggage allowance\", \"Personal AI assistant\", \"Private lounge access\", \"Advanced medical suite\", \"Cryosleep optional\", \"Exclusive events with the captain\"]\n",
        "        }\n",
        "    ];\n",
        "    \n",
        "    // Function to get random item from array\n",
        "    function getRandomItem(array) {\n",
        "        return array[Math.floor(Math.random() * array.length)];\n",
        "    }\n",
        "    \n",
        "    // Function to get multiple unique random items from array\n",
        "    function getMultipleRandomItems(array, count) {\n",
        "        const shuffled = [...array].sort(() => 0.5 - Math.random());\n",
        "        return shuffled.slice(0, count);\n",
        "    }\n",
        "    \n",
        "    // Function to generate cosmic assignment\n",
        "    function generateCosmicAssignment(name) {\n",
        "        const assignedPlanet = getRandomItem(planets);\n",
        "        const assignedJob = getRandomItem(jobs);\n",
        "        const assignedPlantation = getRandomItem(plantationTypes);\n",
        "        const assignedNumber = Math.floor(Math.random() * 42) + 1; // Random number between 1-42\n",
        "        const topReasons = getMultipleRandomItems(reasons, 5);\n",
        "        \n",
        "        return {\n",
        "            name: name,\n",
        "            planet: assignedPlanet,\n",
        "            job: assignedJob,\n",
        "            plantation: assignedPlantation,\n",
        "            number: assignedNumber,\n",
        "            reasons: topReasons\n",
        "        };\n",
        "    }\n",
        "    \n",
        "    // Function to generate random phone number\n",
        "    function generatePhoneNumber() {\n",
        "        const area = Math.floor(Math.random() * 900) + 100; // Random 3-digit area code\n",
        "        const middle = Math.floor(Math.random() * 900) + 100; // Random 3-digit middle\n",
        "        const end = Math.floor(Math.random() * 9000) + 1000; // Random 4-digit end\n",
        "        return `${area}-${middle}-${end}`;\n",
        "    }\n",
        "    \n",
        "    // Function to generate random countdown time\n",
        "    function generateCountdown() {\n",
        "        const days = Math.floor(Math.random() * 30) + 1; // 1-30 days\n",
        "        const hours = Math.floor(Math.random() * 24); // 0-23 hours\n",
        "        const minutes = Math.floor(Math.random() * 60); // 0-59 minutes\n",
        "        return {days, hours, minutes};\n",
        "    }\n",
        "    \n",
        "    // Function to generate random discount percentage\n",
        "    function generateDiscount() {\n",
        "        return Math.floor(Math.random() * 36) + 15; // 15-50% discount\n",
        "    }\n",
        "    \n",
        "    // Function to display assignment results\n",
        "    function displayAssignmentResults(assignment) {\n",
        "        let reasonsHTML = '';\n",
        "        assignment.reasons.forEach((reason, index) => {\n",
        "            reasonsHTML += `<li>${reason}</li>`;\n",
        "        });\n",
        "        \n",
        "        const resultHTML = `\n",
        "            <div class=\"result-item\">\n",
        "                <div class=\"result-title\">Name:</div>\n",
        "                <div>${assignment.name}</div>\n",
        "            </div>\n",
        "            <div class=\"result-item\">\n",
        "                <div class=\"result-title\">Assigned Planet:</div>\n",
        "                <div class=\"cosmic-highlight\">${assignment.planet}</div>\n",
        "            </div>\n",
        "            <div class=\"result-item\">\n",
        "                <div class=\"result-title\">Cosmic Occupation:</div>\n",
        "                <div class=\"cosmic-highlight\">${assignment.job}</div>\n",
        "            </div>\n",
        "            <div class=\"result-item\">\n",
        "                <div class=\"result-title\">Plantation Type:</div>\n",
        "                <div class=\"cosmic-highlight\">${assignment.plantation}</div>\n",
        "            </div>\n",
        "            <div class=\"result-item\">\n",
        "                <div class=\"result-title\">Your Cosmic Number:</div>\n",
        "                <div class=\"cosmic-highlight\">${assignment.number}</div>\n",
        "            </div>\n",
        "            <div class=\"result-item\">\n",
        "                <div class=\"result-title\">Top 5 Reasons for Your Assignment:</div>\n",
        "                <ol class=\"reasons-list\">\n",
        "                    ${reasonsHTML}\n",
        "                </ol>\n",
        "            </div>\n",
        "        `;\n",
        "        \n",
        "        resultContent.innerHTML = resultHTML;\n",
        "        \n",
        "        // Generate next steps information\n",
        "        const countdown = generateCountdown();\n",
        "        const discount = generateDiscount();\n",
        "        const overseerPhone = generatePhoneNumber();\n",
        "        \n",
        "        const nextStepsHTML = `\n",
        "            <div class=\"result-item\">\n",
        "                <div class=\"result-title\">Time Until Next Take-off to ${assignment.planet}:</div>\n",
        "                <div class=\"countdown-timer\">${countdown.days} Days, ${countdown.hours} Hours, ${countdown.minutes} Minutes</div>\n",
        "            </div>\n",
        "            \n",
        "            <div class=\"special-deal\">\n",
        "                <div class=\"result-title\">Special Offer Available!</div>\n",
        "                <p>For a limited time, enjoy <strong>${discount}% off</strong> on your rocket seat to ${assignment.planet}. This exclusive deal is only available for the next 24 hours!</p>\n",
        "                <p><em>* Terms and conditions apply. Offer valid for new cosmic travelers only.</em></p>\n",
        "            </div>\n",
        "            \n",
        "            <div class=\"overseer-contact\">\n",
        "                <div class=\"result-title\">Connect with Your Plantation Overseer</div>\n",
        "                <p>Your assigned overseer for the ${assignment.plantation} is ready to answer any questions you may have about your new role as a ${assignment.job}.</p>\n",
        "                <p><strong>Overseer Contact:</strong> ${overseerPhone}</p>\n",
        "                <a href=\"tel:${overseerPhone}\" class=\"contact-btn\">Call Now</a>\n",
        "            </div>\n",
        "        `;\n",
        "        \n",
        "        document.getElementById('next-steps-content').innerHTML = nextStepsHTML;\n",
        "        assignmentResults.style.display = 'block';\n",
        "        \n",
        "        // Scroll to results\n",
        "        assignmentResults.scrollIntoView({ behavior: 'smooth' });\n",
        "    }\n",
        "    \n",
        "    // Add click event for the generate button\n",
        "    generateBtn.addEventListener('click', function() {\n",
        "        // Store all selected values\n",
        "        selectedValues = {\n",
        "            day: daySelect.value,\n",
        "            month: monthSelect.value,\n",
        "            year: yearSelect.value,\n",
        "            hour: hourSelect.value,\n",
        "            minute: minuteSelect.value\n",
        "        };\n",
        "        \n",
        "        // Display confirmation message\n",
        "        outputMessage.innerHTML = `<h4>Confirm Your Selection</h4>\n",
        "                                  <p>Date: ${selectedValues.day}/${selectedValues.month}/${selectedValues.year}<br>\n",
        "                                  Time: ${selectedValues.hour}:${selectedValues.minute} <br>\n",
        "                                  Location: collected auomatically.</p>\n",
        "                                  <p>Are you sure you want to proceed? Your personal information may be added to our tracking directory if you continue. </p>`;\n",
        "        \n",
        "        // Show confirmation buttons\n",
        "        confirmationButtons.style.display = 'block';\n",
        "    });\n",
        "    \n",
        "    // Add click event for confirm button\n",
        "    confirmBtn.addEventListener('click', function() {\n",
        "        outputMessage.innerHTML = `<h4>Confirmation Successful</h4>\n",
        "                                  <p>Date: ${selectedValues.day}/${selectedValues.month}/${selectedValues.year}<br>\n",
        "                                  Time: ${selectedValues.hour}:${selectedValues.minute}</p>\n",
        "                                  <p>Please enter your name:</p>\n",
        "                                  <div class=\"form-group\">\n",
        "                                    <input type=\"text\" id=\"user-name\" class=\"form-control\" placeholder=\"Enter your name\">\n",
        "                                  </div>\n",
        "                                  <button id=\"submit-name-btn\" class=\"btn btn-primary mt-3\">Submit</button>`;\n",
        "        confirmationButtons.style.display = 'none';\n",
        "        \n",
        "        // Add event listener for the new submit button\n",
        "        setTimeout(() => {\n",
        "            const submitNameBtn = document.getElementById('submit-name-btn');\n",
        "            const userNameInput = document.getElementById('user-name');\n",
        "            \n",
        "            submitNameBtn.addEventListener('click', function() {\n",
        "                const userName = userNameInput.value.trim();\n",
        "                if (userName) {\n",
        "                    // Store the name along with the date/time\n",
        "                    selectedValues.name = userName;\n",
        "                    \n",
        "                    // Show final confirmation\n",
        "                    outputMessage.innerHTML = `<h4>All Information Received</h4>\n",
        "                                            <p>Name: ${selectedValues.name}</p>\n",
        "                                            <p>Date: ${selectedValues.day}/${selectedValues.month}/${selectedValues.year}<br>\n",
        "                                            Time: ${selectedValues.hour}:${selectedValues.minute}</p>\n",
        "                                            <p>Generating your cosmic assignment...</p>`;\n",
        "                    \n",
        "                    // Generate and display the assignment\n",
        "                    setTimeout(() => {\n",
        "                        const assignment = generateCosmicAssignment(selectedValues.name);\n",
        "                        displayAssignmentResults(assignment);\n",
        "                    }, 1000); // Add a slight delay for dramatic effect\n",
        "                    \n",
        "                } else {\n",
        "                    // Show error if name is empty\n",
        "                    userNameInput.style.borderColor = 'red';\n",
        "                    const errorMsg = document.createElement('p');\n",
        "                    errorMsg.style.color = 'red';\n",
        "                    errorMsg.textContent = 'Please enter your name';\n",
        "                    \n",
        "                    // Insert error message after input if it doesn't exist\n",
        "                    if (!userNameInput.nextElementSibling || !userNameInput.nextElementSibling.style || userNameInput.nextElementSibling.style.color !== 'red') {\n",
        "                        userNameInput.parentNode.insertBefore(errorMsg, userNameInput.nextElementSibling);\n",
        "                    }\n",
        "                }\n",
        "            });\n",
        "        }, 100); // Small timeout to ensure the element is in the DOM\n",
        "    });\n",
        "    \n",
        "    // Add click event for cancel button\n",
        "    cancelBtn.addEventListener('click', function() {\n",
        "        outputMessage.innerHTML = '<h4>Cancelled</h4><p>Please adjust your selection if needed.</p>';\n",
        "        confirmationButtons.style.display = 'none';\n",
        "    });\n",
        "});\n",
        "</script>\n",
        "\"\"\"\n",
        "\n",
        "# Display the HTML\n",
        "display(HTML(html_content))"
