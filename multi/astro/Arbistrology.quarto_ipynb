        "}\n",
        "\n",
        ".pricing-table th {\n",
        "    background-color: #f2f2f2;\n",
        "    font-weight: bold;\n",
        "}\n",
        "\n",
        ".pricing-table tr:hover {\n",
        "    background-color: #f5f5f5;\n",
        "}\n",
        "\n",
        ".pricing-highlight {\n",
        "    background-color: #e8f4fd;\n",
        "}\n",
        "\n",
        ".overseer-profile {\n",
        "    display: flex;\n",
        "    align-items: center;\n",
        "    gap: 20px;\n",
        "    margin-bottom: 20px;\n",
        "}\n",
        "\n",
        ".overseer-image {\n",
        "    width: 120px;\n",
        "    height: 120px;\n",
        "    border-radius: 50%;\n",
        "    object-fit: cover;\n",
        "    border: 3px solid #fd7e14;\n",
        "}\n",
        "\n",
        ".overseer-info {\n",
        "    flex: 1;\n",
        "}\n",
        "\n",
        ".overseer-name {\n",
        "    font-size: 1.5rem;\n",
        "    margin-bottom: 5px;\n",
        "    color: #fd7e14;\n",
        "}\n",
        "\n",
        ".history-item, .meaning-item {\n",
        "    margin-bottom: 20px;\n",
